# Deterministic default for tests and no-cost local development.
MODEL_PROVIDER=fake

# D3-approved live provider. Put the real key in .env.local, never in this file.
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MODEL_REQUEST_TIMEOUT_MS=45000
# MODEL_ENGINEERING_TIMEOUT_MS=75000
# LIVE_BUDGET_CNY=10
# LIVE_MAX_RUNS_PER_PROCESS=15
# LIVE_MAX_RUNS_PER_SESSION=3

# Disable live generation without changing the UI contract.
LIVE_GENERATION_ENABLED=false

# Supabase Auth + Postgres. The publishable key is safe for browser use;
# RLS remains the authorization boundary. Never add a service_role key here.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
